/* ================================
   白色主调+蓝色辅助 Qt6 通用样式
   适配所有基础控件，风格简洁清爽
   ================================ */

/* ====== 全局基础样式 ====== */
* {
    font-family: "Microsoft YaHei", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
    color: #4E5969; /* 主要文本色：深灰，保证可读性 */
}

/* 基础窗口/容器 */
QMainWindow, QDialog, QWidget, QFrame {
    background-color: #FFFFFF; /* 主背景：纯白 */
    border: none;
}

/* ====== 按钮控件 ====== */
/* 普通按钮（蓝色主按钮） */
QPushButton {
    background-color: #1677FF; /* 辅助色：主蓝 */
    color: #FFFFFF; /* 文字白 */
    border: none;
    border-radius: 6px; /* 轻微圆角，简约 */
    padding: 8px 16px;
    min-height: 36px;
    min-width: 80px;
}

/* 按钮悬浮态 */
QPushButton:hover {
    background-color: #4096FF; /* 浅蓝 hover */
}

/* 按钮按下态 */
QPushButton:pressed {
    background-color: #0E66D9; /* 深蓝 pressed */
}

/* 按钮禁用态 */
QPushButton:disabled {
    background-color: #F5F7FA; /* 浅灰背景 */
    color: #C9CDD4; /* 浅灰文字 */
}

/* 文本按钮（无背景，仅文字） */
QPushButton[flat="true"] {
    background-color: transparent;
    color: #1677FF; /* 蓝色文字 */
    padding: 8px 12px;
    min-width: 60px;
}

QPushButton[flat="true"]:hover {
    background-color: #E8F3FF; /* 极浅蓝背景 */
    border-radius: 4px;
}

QPushButton[flat="true"]:pressed {
    background-color: #D1E7FF; /* 浅蓝背景 */
}

/* 边框按钮（仅边框，透明背景） */
QPushButton.border-btn {
    background-color: transparent;
    color: #1677FF;
    border: 1px solid #1677FF;
    border-radius: 6px;
}

QPushButton.border-btn:hover {
    background-color: #E8F3FF;
}

/* ====== 输入类控件 ====== */
/* 单行输入框 */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB; /* 浅灰边框 */
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 36px;
    selection-background-color: #1677FF; /* 选中背景蓝 */
    selection-color: #FFFFFF; /* 选中文字白 */
}

/* 输入框悬浮 */
QLineEdit:hover {
    border-color: #C9CDD4;
}

/* 输入框聚焦 */
QLineEdit:focus {
    border-color: #1677FF; /* 聚焦蓝边框 */
    outline: none; /* 去除默认外描边 */
}

/* 输入框禁用 */
QLineEdit:disabled {
    background-color: #F5F7FA;
    color: #C9CDD4;
    border-color: #E5E6EB;
}

/* 多行文本框 */
QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #1677FF;
    selection-color: #FFFFFF;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #1677FF;
    outline: none;
}

/* ====== 选择类控件 ====== */
/* 复选框 */
QCheckBox {
    spacing: 8px; /* 复选框与文字间距 */
    color: #4E5969;
}

/* 复选框指示器（方框） */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #E5E6EB;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #1677FF;
}

/* 复选框选中态 */
QCheckBox::indicator:checked {
    background-color: #1677FF;
    border-color: #1677FF;
    /* 勾选图标（Qt内置） */
    image: url(:/qt-project.org/styles/commonstyle/images/checkbox_checked.png);
}

/* 单选按钮 */
QRadioButton {
    spacing: 8px;
    color: #4E5969;
}

/* 单选按钮指示器（圆圈） */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #E5E6EB;
    border-radius: 9px; /* 圆形 */
    background-color: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #1677FF;
}

/* 单选按钮选中态 */
QRadioButton::indicator:checked {
    border-color: #1677FF;
    /* 内部小圆点 */
    background-color: #1677FF;
    image: none;
}

/* 下拉组合框 */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 36px;
    selection-background-color: #1677FF;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    border-color: #C9CDD4;
}

QComboBox:focus {
    border-color: #1677FF;
    outline: none;
}

/* 下拉箭头 */
QComboBox::drop-down {
    border: none;
    width: 36px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/downarrow.png);
    width: 16px;
    height: 16px;
}

/* 下拉列表 */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 4px 0;
    margin-top: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 36px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E8F3FF; /* 浅蓝 hover */
}

/* ====== 滑动/进度类控件 ====== */
/* 滑块 */
QSlider {
    background: transparent;
}

/* 水平滑块轨道 */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #E5E6EB;
    border-radius: 2px;
}

/* 滑块手柄 */
QSlider::handle:horizontal {
    background-color: #1677FF;
    border: none;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: -6px 0; /* 超出轨道上下 */
}

QSlider::handle:horizontal:hover {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    background-color: #4096FF;
}

/* 滑块已选区域 */
QSlider::add-page:horizontal {
    background-color: #1677FF;
    border-radius: 2px;
}

/* 进度条 */
QProgressBar {
    border: none;
    background-color: #E5E6EB;
    border-radius: 10px;
    height: 8px;
    text-align: center;
    color: #4E5969;
}

/* 进度条进度块 */
QProgressBar::chunk {
    background-color: #1677FF;
    border-radius: 10px;
}

/* ====== 滚动条 ====== */
/* 垂直滚动条 */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0;
}

/* 滚动条滑块 */
QScrollBar::handle:vertical {
    background-color: #C9CDD4;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:horizontal {
    background-color: #C9CDD4;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #1677FF; /* 悬浮变蓝 */
}

/* 隐藏滚动条上下/左右箭头 */
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ====== 标签页 ====== */
QTabWidget::pane {
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    background-color: #FFFFFF;
    margin-top: 8px;
}

QTabBar::tab {
    background-color: transparent;
    color: #86909C;
    padding: 8px 16px;
    margin-right: 4px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #1677FF;
}

QTabBar::tab:selected {
    color: #1677FF;
    border-bottom-color: #1677FF; /* 选中蓝底边框 */
}

/* ====== 列表/表格/树视图 ====== */
QListView, QListWidget, QTableView, QTableWidget, QTreeView, QTreeWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    outline: none;
}

/* 列表项 */
QListView::item, QListWidget::item, QTreeView::item, QTreeWidget::item {
    padding: 8px 12px;
    min-height: 36px;
}

/* 列表项悬浮 */
QListView::item:hover, QListWidget::item:hover, QTreeView::item:hover, QTreeWidget::item:hover {
    background-color: #E8F3FF;
}

/* 列表项选中 */
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected, QTreeWidget::item:selected {
    background-color: #1677FF;
    color: #FFFFFF;
}

/* 表格表头 */
QHeaderView::section {
    background-color: #F5F7FA;
    border: none;
    border-right: 1px solid #E5E6EB;
    padding: 8px 12px;
    color: #4E5969;
}

QHeaderView::section:last {
    border-right: none;
}

/* ====== 菜单 ====== */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 8px 16px;
    min-height: 36px;
}

QMenu::item:hover {
    background-color: #E8F3FF;
    color: #1677FF;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E6EB;
    margin: 4px 0;
}

/* ====== 分组框 ====== */
QGroupBox {
    border: 1px solid #E5E6EB;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 8px;
    color: #4E5969;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: #FFFFFF;
}

/* ====== 工具栏/状态栏 ====== */
QToolBar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E6EB;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #E8F3FF;
}

QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E6EB;
    padding: 4px 12px;
    color: #86909C;
}

/* ====== 提示/消息类 ====== */
/* 工具提示 */
QToolTip {
    background-color: #FFFFFF;
    border: 1px solid #1677FF;
    border-radius: 4px;
    padding: 4px 8px;
    color: #4E5969;
    opacity: 0.95;
}

/* 消息框 */
QMessageBox {
    background-color: #FFFFFF;
    border-radius: 6px;
}

QMessageBox QPushButton {
    min-width: 80px;
}